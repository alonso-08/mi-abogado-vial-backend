# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/asistente_vial

# JWT
JWT_SECRET=tu-secreto-super-seguro-cambiar-en-produccion
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Mercado Pago
MERCADOPAGO_ACCESS_TOKEN=TEST-xxx
MERCADOPAGO_PUBLIC_KEY=TEST-xxx
WEBHOOK_SECRET=tu-secret-de-webhook
# Legacy IPN (notification_url de la preferencia): mantén en False.
# La seguridad real NO depende de la firma: se consulta el pago a la API de MP,
# se acredita solo al external_reference del pago, con dedup por mp_payment_id
# y check de status=approved.
WEBHOOK_VERIFY_SIGNATURE=false
# URL publica del webhook (tunnel/ngrok). Opcional: si se omite, MP usa la webhook del dashboard
WEBHOOK_URL=https://tu-tunnel.ngrok-free.app/api/payments/webhook

# Gemini
GEMINI_API_KEY=tu-api-key-de-gemini

# CORS
ALLOWED_ORIGINS=http://localhost:4200,http://localhost:8000

# Email (Resend)
RESEND_API_KEY=re_tu-api-key-de-resend
EMAILS_FROM_NAME=Asistente Legal Vial
EMAILS_FROM_EMAIL=onboarding@resend.dev
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:4200

# Docs
DOCS_ENABLED=true

# TTS Voice (Edge TTS) - available: es-MX-JorgeNeural (male), es-MX-DaliaNeural (female)
TTS_VOICE=es-MX-JorgeNeural

# Railway Bucket (S3-compatible storage)
# Optional: If configured, files are stored in Railway Bucket (production)
# If not configured, files are stored locally (development)
# Railway auto-injects these when you add a Bucket to your service
# AWS_S3_BUCKET_NAME=my-bucket-abc123
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_ENDPOINT_URL=https://storage.railway.app
# AWS_DEFAULT_REGION=auto
